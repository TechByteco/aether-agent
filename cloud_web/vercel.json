  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/$1" },
    { "source": "/api/chat", "destination": "/api/chat.js" },
    { "source": "/api/models", "destination": "/api/models.js" },
    { "source": "/api/huggingface", "destination": "/api/huggingface.js" },
    { "source": "/api/crm/pipeline", "destination": "/api/crm.js" },
    { "source": "/api/crm/(.*)", "destination": "/api/crm.js" },
    { "source": "/api/status", "destination": "/api/status.js" },
    { "source": "/api/owner/health", "destination": "/api/status.js" },
    { "source": "/api/online/status", "destination": "/api/status.js" }
  ]
}
